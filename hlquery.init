#!/bin/sh
### BEGIN INIT INFO
# Provides:          hlquery
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: hlquery search service
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin

if [ -r /lib/lsb/init-functions ]; then
    . /lib/lsb/init-functions
fi

NAME=hlquery
DAEMON=${HLQUERY_WRAPPER:-/usr/bin/hlquery-wrapper}
SYSTEMCTL=${HLQUERY_SYSTEMCTL:-systemctl}
SERVICE_NAME=${HLQUERY_SERVICE_NAME:-hlquery.service}
RUNTIME_DIR=${HLQUERY_RUNTIME_DIR:-/run/hlquery}
STATE_DIR=${HLQUERY_STATE_DIR:-/var/lib/hlquery}
LOG_DIR=${HLQUERY_LOG_DIR:-/var/log/hlquery}

is_systemd_active() {
    case "${HLQUERY_INIT_MODE:-auto}" in
        sysv)
            return 1
            ;;
        systemd)
            command -v "$SYSTEMCTL" >/dev/null 2>&1
            return $?
            ;;
        auto)
            command -v "$SYSTEMCTL" >/dev/null 2>&1 && [ -d /run/systemd/system ]
            ;;
        *)
            echo "Invalid HLQUERY_INIT_MODE: ${HLQUERY_INIT_MODE}" >&2
            return 1
            ;;
    esac
}

ensure_runtime_dirs() {
    mkdir -p "$RUNTIME_DIR" "$STATE_DIR" "$LOG_DIR" || return 1
    chmod 755 "$RUNTIME_DIR" "$STATE_DIR" "$LOG_DIR" || return 1

    if id -u "$NAME" >/dev/null 2>&1; then
        chown "$NAME:$NAME" "$RUNTIME_DIR" "$STATE_DIR" "$LOG_DIR" || return 1
    fi
}

run_systemd_command() {
    action="$1"
    shift

    case "$action" in
        start)
            echo "Starting $NAME service..."
            ;;
        stop)
            echo "Stopping $NAME service..."
            ;;
        restart)
            echo "Restarting $NAME service..."
            ;;
    esac

    if "$SYSTEMCTL" "$action" "$SERVICE_NAME"; then
        case "$action" in
            start)
                echo "$NAME service started."
                ;;
            stop)
                echo "$NAME service stopped."
                ;;
            restart)
                echo "$NAME service restarted."
                ;;
        esac
        return 0
    fi

    echo "Failed to $action $NAME service. Run: journalctl -u $SERVICE_NAME -n 80 --no-pager" >&2
    return 1
}

run_daemon_command() {
    if [ ! -x "$DAEMON" ]; then
        echo "$NAME executable not found at $DAEMON" >&2
        return 1
    fi

    "$DAEMON" "$@"
}

case "$1" in
    start)
        if is_systemd_active; then
            run_systemd_command start
            exit $?
        fi
        ensure_runtime_dirs || {
            echo "Failed to prepare runtime directories for $NAME." >&2
            exit 1
        }
        run_daemon_command start
        exit $?
        ;;
    stop)
        if is_systemd_active; then
            run_systemd_command stop
            exit $?
        fi
        run_daemon_command stop
        exit $?
        ;;
    restart|force-reload)
        if is_systemd_active; then
            run_systemd_command restart
            exit $?
        fi
        run_daemon_command restart
        exit $?
        ;;
    status)
        if is_systemd_active; then
            exec "$SYSTEMCTL" status "$SERVICE_NAME"
        fi
        run_daemon_command status
        exit $?
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
        exit 1
        ;;
esac
